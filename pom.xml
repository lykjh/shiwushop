<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>
    <groupId>com</groupId>
    <artifactId>shiwushop-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>shiwushop-common</module>
        <module>shiwushop-core</module>
        <module>shiwushop-search</module>
        <module>shiwushop-app</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <logback.version>1.6.5</logback.version>
        <tomcat.version>11.0.27</tomcat.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <rabbit-amqp-client.version>5.33.1</rabbit-amqp-client.version>
        <mysql.version>9.6.0</mysql.version>
    </properties>
    <!-- 只统一版本；各子模块按真实使用声明依赖，避免核心被动引入 Web 和渠道 SDK。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com</groupId>
                <artifactId>shiwushop-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com</groupId>
                <artifactId>shiwushop-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com</groupId>
                <artifactId>shiwushop-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>dypnsapi20170525</artifactId>
                <version>2.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>3.5.17</version>
            </dependency>
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>4.40.1031.ALL</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>3.5.4</version>
            </dependency>
            <dependency>
                <groupId>cloud.tianai.captcha</groupId>
                <artifactId>tianai-captcha-springboot-starter</artifactId>
                <version>1.5.5</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 库模块没有所选用例时继续构建；app 会检查目标用例确实存在。 -->
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <systemPropertyVariables>
                        <shiwushop.project-root>${maven.multiModuleProjectDirectory}</shiwushop.project-root>
                        <!-- test disables the local 7001-7006 cluster document in application.yml. -->
                        <spring.profiles.active>test,verifyCode</spring.profiles.active>
                        <spring.autoconfigure.exclude>org.springframework.boot.session.data.redis.autoconfigure.SessionDataRedisAutoConfiguration</spring.autoconfigure.exclude>
                        <!-- Tests always use the disposable local database, never the storefront database. -->
                        <spring.datasource.url>jdbc:mysql://127.0.0.1:13306/shiwushop?useUnicode=true&amp;characterEncoding=utf8&amp;serverTimezone=Asia/Shanghai</spring.datasource.url>
                        <spring.datasource.username>shiwushop</spring.datasource.username>
                        <spring.datasource.password>test-shiwushop</spring.datasource.password>
                        <spring.data.redis.port>16379</spring.data.redis.port>
                        <spring.config.import>optional:file:./target/no-local.yml</spring.config.import>
                        <!-- Config import 仍会读取本地文件；测试必须显式隔离搜索开关和地址。 -->
                        <shop.search.url>http://127.0.0.1:29200</shop.search.url>
                        <shop.search.discovery-enabled>false</shop.search.discovery-enabled>
                        <shop.search.worker-enabled>false</shop.search.worker-enabled>
                        <shop.aftersale.timeout-scan-delay-ms>600000</shop.aftersale.timeout-scan-delay-ms>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
