<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shiwushop.commerce.mapper.cart.CartItemMapper">
    <select id="selectOwnedForUpdate" resultType="com.shiwushop.commerce.entity.cart.CartItem">
        SELECT id, user_id AS userId, sku_id AS skuId, quantity
        FROM cart_items WHERE id = #{id} AND user_id = #{userId} FOR UPDATE
    </select>
</mapper>
